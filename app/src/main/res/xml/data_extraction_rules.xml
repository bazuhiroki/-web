<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- APIキーと個人プロフィールは端末外に出さない。 -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
